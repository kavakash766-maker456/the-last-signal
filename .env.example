# ==========================================
# THE LAST SIGNAL - Environment Variables
# ==========================================

# Client Configuration (.env in /client)
VITE_SERVER_URL=ws://localhost:2567
# In production on Vercel, set VITE_SERVER_URL to your Render WebSocket URL:
# VITE_SERVER_URL=wss://the-last-signal-server.onrender.com

# Server Configuration (.env in /server)
PORT=2567
NODE_ENV=development
CORS_ORIGIN=*
